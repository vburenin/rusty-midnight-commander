# Apache-2.0 original keymap data for Rusty Midnight Commander
# Format: one binding per line as "Key = Action".
# Keys follow MC-like notation:
#   - Function keys: F1..F12
#   - Control: C-x (e.g., C-r)
#   - Alt/Meta: Alt-x (e.g., Alt-n)
#   - Names: Up, Down, Left, Right, Home, End, PageUp, PageDown, Tab, Enter, Backspace, Insert, Space
#
# Actions use existing rmc_core::actions::Action variant names (simplified):
#   MoveUp, MoveDown, PageUp, PageDown, Home, End, Enter, ParentDir, SwitchPanel, ToggleHidden,
#   SwapPanels, Refresh, Repaint, ShowHelp, ViewFile, Copy, Move, Mkdir, Delete, FocusMenu, Quit,
#   ToggleSelect, SortName, SortTime, CycleListingFormat, QuickSearch

# Movement and navigation
Up        = MoveUp
Down      = MoveDown
PageUp    = PageUp
PageDown  = PageDown
Home      = Home
End       = End
# GNU mc(1) Directory Panels aliases (A1/C1 are keypad Home/End → Home/End)
C-p       = MoveUp
C-n       = MoveDown
Alt-v     = PageUp
C-v       = PageDown
# GNU mc(1) Directory Panels: jump to top/middle/bottom currently visible file
Alt-g     = PanelJumpTop
Alt-r     = PanelJumpMiddle
Alt-j     = PanelJumpBottom
Tab       = SwitchPanel
C-i       = SwitchPanel
Enter     = Enter
Backspace = ParentDir
C-PageUp  = ParentDir

# Toggles and refresh
C-h     = ToggleHidden
C-u     = SwapPanels
C-r     = Refresh
# GNU mc(1) Miscellaneous Keys: C-l redraw / repaint the screen (not C-r Reload)
C-l     = Repaint
C-o     = ToggleSubshell

# Function keys (F-bar)
F1  = ShowHelp
F2  = ShowUserMenu
F3  = ViewFile
F4  = FunctionKey4
F5  = Copy
F6  = Move
F7  = Mkdir
F8  = Delete
F9  = FocusMenu
F10 = Quit
# GNU mc(1) File menu Shift-F / F13–F20 (F13 view-raw, F14 edit-new, F15/F16 copy/move to current panel)
F13   = FunctionKey13
S-F3  = FunctionKey13
F14   = FunctionKey14
S-F4  = FunctionKey14
F15   = FunctionKey15
S-F5  = FunctionKey15
F16   = FunctionKey16
S-F6  = FunctionKey16
# GNU mc.keymap: DeleteSingle=f18 (cursor file only); MenuLastSelected=f19
F18   = DeleteSingle
S-F8  = DeleteSingle
F19   = MenuLastSelected
S-F9  = MenuLastSelected
F20   = Quit
S-F10 = Quit

# GNU mc(1) Quick search (C-s / Alt-s). Sort by size remains on the Sort order dialog.
C-s   = QuickSearch
Alt-s = QuickSearch
# Sorting shortcuts (Alt variants)
Alt-n = SortName
# GNU mc(1) Alt-t: cycle listing format Full → Brief → Long → User → Full
Alt-t = CycleListingFormat
# GNU mc Layout: Alt-, toggles Vertical ↔ Horizontal panel split
Alt-, = TogglePanelSplit

# Directory hotlist
C-\\ = OpenHotlist
# GNU mc 4.8.33 Find = alt-question (help: Alt-?). F17 is viewer search-again.
Alt-question = FindFile
# Note: 'C-x h' (Add current dir to hotlist) is handled as a key chord by the UI layer.

# Selection (GNU mc(1) Insert / C-t toggle mark)
Insert = ToggleSelect
C-t    = ToggleSelect
Space  = ToggleSelect
# Group selection (panel)
+  = SelectGroup
\\  = UnselectGroup
*  = InvertSelection

# Control-X chords (handled by UI prefix state)
C-x c = Chmod
C-x o = Chown
C-x l = LinkHard
C-x s = SymlinkAbs
C-x v = SymlinkRel

